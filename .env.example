# User API key from https://cursor.com/dashboard/integrations (for Cursor jobs).
# Optional: a UI can also set it at runtime (PUT /auth/cursor/key); this variable wins over that.
CURSOR_API_KEY=

# ---- Claude Code (optional) -----------------------------------------------------------------
# One of these, first set wins. Or leave both empty and sign in from the container:
#   docker exec -it agent-worker python -m agent_worker.claude_login
# Claude Plan token (sk-ant-oat…) from `claude setup-token`: uses your Claude subscription.
# CLAUDE_CODE_OAUTH_TOKEN=
# Anthropic API key (sk-ant-api…) from https://console.anthropic.com/settings/keys: API credits.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- OpenAI Codex (optional) ----------------------------------------------------------------
# ChatGPT plan: sign in once from the container (device code; enable device code login in
# ChatGPT > Settings > Security first). The login is kept in /data/codex/auth.json:
#   docker exec -it agent-worker python -m agent_worker.codex_login
# Or copy an auth.json from `codex login` on another computer once (mounted file or the JSON itself):
# CODEX_AUTH_JSON=/run/secrets/codex_auth.json
# Fallback without a sign-in: an OpenAI API key (API billing), from https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Model when a Codex job names none. Empty: Codex's default for the account.
# CODEX_MODEL=gpt-5.5
# container (default): the container is the sandbox. codex: Codex's own bubblewrap sandbox, needs
# user namespaces (see security_opt in docker-compose.yml).
# CODEX_SANDBOX=container
# Extra Codex settings, one key=value per line (TOML values, like `codex -c`).
# CODEX_CONFIG=

# Engine for jobs that do not name one: cursor, claude or codex. Empty: cursor, or the first other one set up.
# DEFAULT_ENGINE=

# /v1 streams: where agent steps go. reasoning_content (default; Open WebUI and Hermes show it as thinking),
# reasoning, or none (only the answer). Clients can override it per request with the X-Agent-Steps header.
# OPENAI_STEPS=reasoning_content

# Required unless the worker only listens on 127.0.0.1 inside the container's network.
# Generate one with:  openssl rand -hex 32
WORKER_TOKEN=

# Model when a caller does not name one.
CURSOR_MODEL=composer-2.5

# Ceiling for what an agent may use. Callers can only narrow it.
#   full     everything (files, shell, web, MCP)
#   local    no web search / web fetch (shell can still reach the network)
#   offline  no web, no shell: files and MCP only
#   mcp      MCP tools only, no files
#   none     plain chat
TOOL_PROFILE=full

# Callers may send their own http/sse MCP servers with a job (never stdio).
ALLOW_REQUEST_MCP=true
# Callers may name a workspace that does not exist yet; it is created empty.
CREATE_WORKSPACES=true

# Jobs in different workspaces run in parallel up to this many; file jobs in one workspace take turns.
MAX_CONCURRENT_JOBS=2
# Watchdogs: longest run, longest stretch without engine output (0 = off), longest wait in
# input_required (then the job is cancelled: "approval timed out"). Before 0.5.0 the first was
# JOB_TIMEOUT_SECONDS and the last SSH_APPROVAL_TIMEOUT; both names still work.
JOB_MAX_RUNTIME_SECONDS=3600
JOB_IDLE_TIMEOUT_SECONDS=900
APPROVAL_TIMEOUT_SECONDS=1800
# How long the MCP tool waits before answering "still running, here is the job_id".
# Keep it below the MCP client's tool timeout (Bifrost: 30 s by default).
MCP_WAIT_SECONDS=20
# No MCP wait is longer than this, whatever wait_seconds a caller asks for.
MCP_MAX_WAIT_SECONDS=25
# MCP cancellation: an open agent_run call that the client cancels (notifications/cancelled) or
# drops (disconnect) cancels its job, unless the job was started with background=true.
MCP_CANCEL_ON_CANCELLED=true
MCP_CANCEL_ON_DISCONNECT=true
# Job statuses follow MCP Tasks (queued, working, input_required, completed, failed, cancelled).
# "legacy" reports the names before 0.5.0 (running, needs_approval, succeeded) in `status` again;
# legacy_status always has them.
JOB_STATUS_NAMES=mcp
# pollInterval in the MCP Task view of an open job (ms).
TASK_POLL_INTERVAL_MS=5000

# Default workspace bound to a host folder (see the volume in docker-compose.yml).
# WORKSPACE_DIR=/workspace

# Clone a repository into the default workspace on first start.
# GIT_REPO=git@github.com:you/repo.git
# GIT_BRANCH=main
# GIT_SSH_KEY=/run/secrets/git_ssh
# GIT_TOKEN=
# GIT_USER_NAME=Agent Worker
# GIT_USER_EMAIL=agent-worker@localhost

# ---- SSH to your servers -------------------------------------------------------------------
# Use a key made for the worker (not your personal one), one per server or group, so you can
# revoke it alone. Each value is the content itself or a path to a mounted file.
# SSH_KEY=/run/secrets/worker_ssh_key
# SSH_KEYS_DIR=/run/secrets/ssh-keys          # several keys; refer to them as ~/.ssh/keys/<file>
# SSH_CONFIG=/run/secrets/ssh_config          # Host aliases, HostName, User, Port, IdentityFile
# SSH_KNOWN_HOSTS=/run/secrets/known_hosts    # pins host keys; without it the first key seen is kept
# SSH_STRICT_HOST_KEYS=yes                    # yes | accept-new

# Hosts where a job pauses before the first command until a human approves (patterns on the
# ssh alias or its HostName, comma separated). Approval holds for that host for the rest of the job.
# SSH_APPROVAL_HOSTS=prod-*,db01,10.0.1.*
# How long an approval may wait is APPROVAL_TIMEOUT_SECONDS above.
# Let MCP callers pass the user's answer with a agent_approve tool. Off by default: the calling
# model could approve on its own. Clients with elicitation ask the user directly either way.
# APPROVAL_TOOL=false

# Extra standing instructions for every new agent.
# WORKER_INSTRUCTIONS=

# MCP servers at 127.0.0.1 on the host: rewrite to the Docker host.
# REWRITE_LOOPBACK_HOST=host.docker.internal
